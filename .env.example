# PostgreSQL service credentials (used during container initialization)
POSTGRES_DB=nl2sql
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Dual least-privilege PostgreSQL connection strings (override passwords outside local dev)
READONLY_DATABASE_URL=postgresql://nl2sql_ro:nl2sql_ro@postgres:5432/nl2sql
LOG_DATABASE_URL=postgresql://nl2sql_logger:nl2sql_logger@postgres:5432/nl2sql
STATEMENT_TIMEOUT_MS=3000

# Inference settings: "mock" is the safe GPU-free Docker default; use "qlora" with 4 GB+ VRAM
INFERENCE_MODE=mock
CONFIG_PATH=training/config.yaml
# ADAPTER_DIR accepts either a Hugging Face Hub repo ID (plug-and-play) or a local directory:
#   Hugging Face Hub: yassinelaabidi0/qwen2.5-3b-nl2sql-qlora
#   Local directory:  outputs/qwen2.5-3b-nl2sql-qlora
ADAPTER_DIR=yassinelaabidi0/qwen2.5-3b-nl2sql-qlora
